# Copy to scripts/.env.backup (gitignored) and fill in. Used by db_backup.sh / db_restore.sh.
#
# Prod Postgres connection string (Railway dashboard -> Postgres service -> Connect).
# Keep this file OUT of git — it contains credentials.
DATABASE_URL=postgresql://user:password@host:port/dbname

# Where dumps are written (a local drive with plenty of space).
BACKUP_DIR=./backups

# Postgres MAJOR version of the server — MUST match (Railway runs 15-17).
# Confirm with:  SELECT version();
PG_MAJOR=16

# Prune dumps older than this many days (0 disables pruning).
RETENTION_DAYS=30
